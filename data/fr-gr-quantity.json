   "s": "Il n'y a plus {de} pain.",
   "de": "kein … mehr"
  },
  {
   "id": "fr-gr-quantity-06",
   "s": "Je voudrais un kilo {de} pommes.",
   "de": "ein Kilo"
  },
  {
   "id": "fr-gr-quantity-07",
   "s": "Une bouteille {d'}eau, s'il vous plaît.",
   "de": "eine Flasche (vor Vokal)"
  },
  {
   "id": "fr-gr-quantity-08",
   "s": "J'achète un paquet {de} biscuits.",
   "de": "eine Packung"
